# Copy to .env.local and fill in. Never commit real values.

# Supabase (public anon key only; never the service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gmail SMTP for booking emails. Server only: never prefix with NEXT_PUBLIC_.
# SMTP_APP_PASSWORD is a Google App Password, not the account password.
SMTP_USER=
SMTP_APP_PASSWORD=
